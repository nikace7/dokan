# Copy to .env and fill in. NEVER commit real secrets — .env is gitignored.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=.dokan.com.np,dokan.com.np
ROOT_DOMAIN=dokan.com.np

# --- Postgres (app connects as the RLS-constrained role) ---
DATABASE_NAME=dokan
DATABASE_USER=dokan_app
DATABASE_PASSWORD=change-me-app-password
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Role bootstrap (used only by docker/postgres/init on first start) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-password
DOKAN_APP_PASSWORD=change-me-app-password
DOKAN_MIGRATOR_PASSWORD=change-me-migrator-password

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SMS_PROVIDER=log

# --- Caddy ---
# CLOUDFLARE_API_TOKEN=only-in-production-for-dns-01-wildcard-tls
