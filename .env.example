# Copy to .env and fill in. NEVER commit real secrets — .env is gitignored.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=.dokan.com.np,dokan.com.np,backend
ROOT_DOMAIN=dokan.com.np
# Required to use /api/v1/admin/*; comma-separated IPs or CIDRs.
PLATFORM_ADMIN_ALLOWED_IPS=127.0.0.1/32

# --- Postgres (app connects as the RLS-constrained role) ---
DATABASE_NAME=dokan
DATABASE_USER=dokan_app
DATABASE_PASSWORD=change-me-app-password
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Role bootstrap (used only by docker/postgres/init on first start) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-password
DOKAN_APP_PASSWORD=change-me-app-password
DOKAN_MIGRATOR_PASSWORD=change-me-migrator-password
DOKAN_MONITOR_PASSWORD=change-me-monitor-password

# --- PostgreSQL recovery (production profile) ---
# Keep archive_mode off for local development; production must set it to on.
POSTGRES_ARCHIVE_MODE=off
POSTGRES_ARCHIVE_TIMEOUT_SECONDS=300
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BASE_BACKUP_ENABLED=true
BASE_BACKUP_INTERVAL_DAYS=7
BASE_BACKUP_RETENTION_DAYS=35
WAL_UPLOAD_INTERVAL_SECONDS=60
WAL_LOCAL_RETENTION_DAYS=2
RESTORE_DATABASE=dokan_restore_drill
REQUIRE_OBJECT_STORAGE=true
# S3-compatible bucket/prefix, for example s3://dokan-prod-backups.
BACKUP_S3_URI=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SMS_PROVIDER=log

# --- Observability (enable only with `--profile monitoring`) ---
METRICS_ENABLED=false
GUNICORN_WORKERS=4
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
UPTIME_KUMA_PORT=3001
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Email (storefront OTP login codes + order confirmations) ---
# Local default: console backend (prints to the backend logs). Production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend plus host auth.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=mero-pasal.online <no-reply@mero-pasal.online>

# --- Caddy ---
# Production: /etc/caddy/tls-cloudflare. Local: /etc/caddy/tls-local.
CADDY_TLS_CONFIG=/etc/caddy/tls-local
# CLOUDFLARE_API_TOKEN=only-in-production-for-dns-01-wildcard-tls
