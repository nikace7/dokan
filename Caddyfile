# Public single-VPS edge. API requests preserve the original Host so Django's
# subdomain tenant resolver remains the only source of tenant identity.

# Optional global options (empty by default). Deployments that run Caddy behind
# an outer TLS-terminating edge set e.g. CADDY_GLOBAL_OPTIONS="auto_https off".
{
	{$CADDY_GLOBAL_OPTIONS}
}

(backend_routes) {
	@backend path /api/* /django-admin*
	handle @backend {
		reverse_proxy backend:8000 {
			# Deployment-specific header directives (empty by default). Behind an
			# outer TLS edge: pin X-Forwarded-Proto and pass the outer XFF chain.
			{$CADDY_PROXY_HEADER_PROTO}
			{$CADDY_PROXY_HEADER_XFF}
		}
	}

	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	# Uploaded media (item images): shared volume with the backend, served
	# read-only — mirrors the staticfiles pattern above.
	handle_path /media/* {
		root * /srv/django-media
		file_server
	}
}

(app_routes) {
	import backend_routes

	handle {
		reverse_proxy frontend:8080
	}
}

# Public online stores: same backend/media plumbing, but the static site is
# the storefront SPA, not the POS app.
(shopfront_routes) {
	import backend_routes

	handle {
		reverse_proxy storefront:8080
	}
}

(security_headers) {
	encode zstd gzip
	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

# Tenant shops. Production sets CADDY_TLS_CONFIG to tls-cloudflare; local uses
# Caddy's internal CA. Behind an outer TLS-terminating edge, set
# CADDY_ADDRESS_SCHEME=http:// and CADDY_TLS_CONFIG=/etc/caddy/tls-off.
{$CADDY_ADDRESS_SCHEME}*.{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}

# Online storefronts live on the separate *.shop.<root> namespace so POS hosts
# and public shop hosts can never collide. Caddy issues its own wildcard cert
# (*.shop.<root>) — Cloudflare DNS-01 in production, internal CA locally, and
# the existing *. DNS record already covers the extra label.
{$CADDY_ADDRESS_SCHEME}*.shop.{$ROOT_DOMAIN} {
	import shopfront_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}

# Exact platform hosts retain separate application auth realms.
{$CADDY_ADDRESS_SCHEME}admin.{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}

# Landing hosts (www/app) and the bare apex serve the tenant SPA without a
# shop context; the middleware treats them as tenant-less public hosts.
{$CADDY_ADDRESS_SCHEME}www.{$ROOT_DOMAIN}, {$CADDY_ADDRESS_SCHEME}app.{$ROOT_DOMAIN}, {$CADDY_ADDRESS_SCHEME}{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}
