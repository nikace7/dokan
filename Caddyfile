# Public single-VPS edge. API requests preserve the original Host so Django's
# subdomain tenant resolver remains the only source of tenant identity.

(app_routes) {
	@backend path /api/* /django-admin*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle_path /static/* {
		root * /srv/django-static
		file_server
	}

	# Uploaded media (item images): shared volume with the backend, served
	# read-only — mirrors the staticfiles pattern above.
	handle_path /media/* {
		root * /srv/django-media
		file_server
	}

	handle {
		reverse_proxy frontend:8080
	}
}

(security_headers) {
	encode zstd gzip
	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

# Tenant shops. Production sets CADDY_TLS_CONFIG to tls-cloudflare; local uses
# Caddy's internal CA.
*.{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}

# Exact platform hosts retain separate application auth realms.
admin.{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}

www.{$ROOT_DOMAIN}, app.{$ROOT_DOMAIN} {
	import app_routes
	import security_headers
	import {$CADDY_TLS_CONFIG:/etc/caddy/tls-local}
}
