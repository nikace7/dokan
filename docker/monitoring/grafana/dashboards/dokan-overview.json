{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(dokan_http_requests_total[5m]))",
          "legendFormat": "all requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx percentage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(dokan_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(dokan_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Sales p95 latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dokan_http_request_duration_seconds_bucket{route=~\"sales:sale-list|sales:sale-complete\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scrape targets",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}, "type": "value"}
          ]
        },
        "overrides": []
      },
      "targets": [{"expr": "up", "legendFormat": "{{job}}", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Celery queue depth",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {"expr": "sum(celery_queue_length)", "legendFormat": "waiting", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "maximum",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Host disk free percentage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Recovery signal age",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "time() - dokan_backup_last_success_timestamp_seconds",
          "legendFormat": "logical backup",
          "refId": "A"
        },
        {
          "expr": "time() - dokan_base_backup_last_success_timestamp_seconds",
          "legendFormat": "base backup",
          "refId": "B"
        },
        {
          "expr": "time() - dokan_wal_upload_last_success_timestamp_seconds",
          "legendFormat": "WAL upload",
          "refId": "C"
        },
        {
          "expr": "time() - dokan_restore_drill_last_success_timestamp_seconds",
          "legendFormat": "restore drill",
          "refId": "D"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["dokan", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Dokan production overview",
  "uid": "dokan-production",
  "version": 1
}
