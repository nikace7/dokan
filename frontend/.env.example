# Base URL of the Django API. Leave unset to use same-origin `/api` (the Vite
# dev server proxies it to http://demo.localhost:8000 so the request host
# carries the demo tenant — see vite.config.ts).
VITE_API_BASE_URL=

# Demo billing defaults (see src/lib/config.ts). No branch/rate-type list
# endpoint exists yet, so the billing screen needs the seeded demo IDs.
# Find them on the demo host: GET /api/v1/sales shows recent invoices with
# their branch / rate_type, or query the demo DB directly.
VITE_DEMO_BRANCH_ID=
VITE_DEMO_RATE_TYPE_ID=
